nextflow_workflow {
    name "Test BGC_ABUNDANCE"
    script "subworkflows/local/bgc_abundance.nf"
    workflow "BGC_ABUNDANCE"

    test("Real container: Bowtie2 + Samtools + CoverM + AGGREGATE_BGC_ABUNDANCE quantifies synthetic reads") {
        when {
            params {
                abundance_mapper = 'bowtie2'
                abundance_min_identity = 95.0
            }
            workflow {
                """
                input[0] = Channel.of(
                    [
                        [id: 'sample1', single_end: false, assay_type: 'metagenome'],
                        [
                            file("${projectDir}/tests/data/reads/sample1_R1.fastq.gz", checkIfExists: true),
                            file("${projectDir}/tests/data/reads/sample1_R2.fastq.gz", checkIfExists: true)
                        ]
                    ]
                )
                input[1] = Channel.of(
                    [
                        [id: 'cohort_regions'],
                        file("${projectDir}/tests/data/comparative", checkIfExists: true)
                    ]
                )
                input[2] = Channel.empty()
                input[3] = Channel.empty()
                """
            }
        }
        then {
            assert workflow.success
            assert workflow.out.bgc_tpm_tsv.size() == 1
            assert workflow.out.bgc_rpkm_tsv.size() == 1
            assert workflow.out.bgc_covered_fraction_tsv.size() == 1
            assert workflow.out.gcf_tpm_tsv.size() == 1
            assert workflow.out.activity_summary_tsv.size() == 1
            assert workflow.out.abundance_mqc.size() == 1

            def tpmLines = path(workflow.out.bgc_tpm_tsv[0]).readLines()
            assert tpmLines.size() >= 2
            assert tpmLines[0] == "bgc_id\tsample1"
            def firstVal = tpmLines[1].split("\t")[1] as Double
            assert firstVal > 0.0

            def covLines = path(workflow.out.bgc_covered_fraction_tsv[0]).readLines()
            def covVal = covLines[1].split("\t")[1] as Double
            assert covVal > 0.5
        }
    }

    test("Real container: Minimap2 + CoverM + AGGREGATE_BGC_ABUNDANCE quantifies synthetic reads") {
        when {
            params {
                abundance_mapper = 'minimap2'
                abundance_min_identity = 95.0
                minimap2_extra_args = '-ax sr'
            }
            workflow {
                """
                input[0] = Channel.of(
                    [
                        [id: 'sample1', single_end: false, assay_type: 'metatranscriptome'],
                        [
                            file("${projectDir}/tests/data/reads/sample1_R1.fastq.gz", checkIfExists: true),
                            file("${projectDir}/tests/data/reads/sample1_R2.fastq.gz", checkIfExists: true)
                        ]
                    ]
                )
                input[1] = Channel.of(
                    [
                        [id: 'cohort_regions'],
                        file("${projectDir}/tests/data/comparative", checkIfExists: true)
                    ]
                )
                input[2] = Channel.empty()
                input[3] = Channel.empty()
                """
            }
        }
        then {
            assert workflow.success
            assert workflow.trace.succeeded().any { it.name.contains("MINIMAP2_INDEX") }
            assert workflow.trace.succeeded().any { it.name.contains("MINIMAP2_ALIGN") }
            assert workflow.trace.succeeded().any { it.name.contains("COVERM_CONTIG") }
            assert workflow.trace.succeeded().any { it.name.contains("AGGREGATE_BGC_ABUNDANCE") }

            def tpmLines = path(workflow.out.bgc_tpm_tsv[0]).readLines()
            assert tpmLines.size() >= 2
            def firstVal = tpmLines[1].split("\t")[1] as Double
            assert firstVal > 0.0
            def covLines = path(workflow.out.bgc_covered_fraction_tsv[0]).readLines()
            def covVal = covLines[1].split("\t")[1] as Double
            assert covVal > 0.5
        }
    }
}

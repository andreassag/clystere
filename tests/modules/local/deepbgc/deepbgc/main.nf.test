nextflow_process {
    name "Test DEEPBGC_PIPELINE"
    script "modules/local/deepbgc/deepbgc/main.nf"
    process "DEEPBGC_PIPELINE"
    options "-stub-run"
    topics "versions"

    test("Stub run emits deepBGC outputs") {
        when {
            params {
                bigscape_run = false
                bigslice_run = false
                max_cpus = 2
                max_memory = "4.GB"
                max_time = "1.h"
            }
            process {
                """
                input[0] = Channel.of([
                    [id: 'GCF_003176835'],
                    file("${projectDir}/assets/genomes/GCF_003176835.fna.gz", checkIfExists: true)
                ])
                input[1] = Channel.of(
                    file("${projectDir}/tests/data/deepbgc_downloads", checkIfExists: true)
                )
                """
            }
        }

        then {
            assert process.success
            assert process.out.output_dir.size() == 1
            assert process.out.bgc_tsv.size() == 1
            assert topics.versions.size() == 1
        }
    }
}

nextflow_process {
    name "Test DEEPBGC_DOWNLOAD"
    script "modules/local/deepbgc/download/main.nf"
    process "DEEPBGC_DOWNLOAD"
    options "-stub-run"
    topics "versions"

    test("Stub run emits destination and versions topic") {
        when {
            params {
                max_cpus = 2
                max_memory = "4.GB"
                max_time = "1.h"
            }
            process {
                """
                input[0] = Channel.of("${outputDir}/deepbgc_data")
                """
            }
        }

        then {
            assert process.success
            assert process.out.data_dir.size() == 1
            assert process.out.data_dir[0].toString().contains("deepbgc_data")
            assert topics.versions.size() == 1
        }
    }
}nextflow_process {
    name "Test DEEPBGC_DOWNLOAD"
    script "modules/local/deepbgc/download/main.nf"
    process "DEEPBGC_DOWNLOAD"
    options "-stub-run"
    topics "versions"

    test("Stub run emits destination and versions") {
        when {
            params {
                max_cpus = 2
                max_memory = "4.GB"
                max_time = "1.h"
            }
            process {
                """
                input[0] = Channel.of("${outputDir}/deepbgc_data")
                """
            }
        }

        then {
            assert process.success
            assert process.out.data_dir.size() == 1
            assert process.out.data_dir[0].toString().contains("deepbgc_data")
            assert process.out.versions.size() == 1
            assert path(process.out.versions[0]).exists()
            assert path(process.out.versions[0]).text.contains("deepbgc")
            assert topics.versions.size() == 1
        }
    }
}

nextflow_process {
    name "Test BIGSCAPE"
    script "modules/local/bigscape/main.nf"
    process "BIGSCAPE"
    options "-stub"
    topics "versions"

    test("BIGSCAPE stub execution") {
        when {
            process {
                """
                input[0] = [
                    file("${projectDir}/tests/data/antismash/GCA_000005845", checkIfExists: true)
                ]
                input[1] = []
                """
            }
        }
        then {
            assert process.success
            assert path(process.out.db[0]).exists()
            assert path(process.out.results_dir[0]).exists()
            assert topics.versions.size() == 1
        }
    }
}

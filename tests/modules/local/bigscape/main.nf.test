nextflow_process {
    name "Test BIGSCAPE"
    script "modules/local/bigscape/main.nf"
    process "BIGSCAPE"
    options "-stub"
    topics "versions"

    test("BIGSCAPE stub execution with dereplicate") {
        when {
            process {
                """
                input[0] = [
                    file("${projectDir}/tests/data/antismash/GCA_000005845", checkIfExists: true)
                ]
                input[1] = []
                input[2] = true
                input[3] = false
                """
            }
        }
        then {
            assert process.success
            assert path(process.out.dereplicate_dir[0]).exists()
            assert path(process.out.db[0]).exists()
            assert path(process.out.results_dir[0]).exists()
            assert process.out.archive.size() == 0
            assert topics.versions.size() == 1
        }
    }

    test("BIGSCAPE stub execution without dereplicate and with zip archive") {
        when {
            process {
                """
                input[0] = [
                    file("${projectDir}/tests/data/antismash/GCA_000005845", checkIfExists: true)
                ]
                input[1] = []
                input[2] = false
                input[3] = true
                """
            }
        }
        then {
            assert process.success
            assert process.out.dereplicate_dir.size() == 0
            assert path(process.out.db[0]).exists()
            assert path(process.out.archive[0]).exists()
            assert topics.versions.size() == 1
        }
    }
}

nextflow_process {
    name "Test ANTISMASH_DOWNLOAD"
    script "modules/local/antismash/download/main.nf"
    process "ANTISMASH_DOWNLOAD"
    options "-stub-run"

    test("Stub run emits destination and marker") {
        when {
            params {
                max_cpus = 2
                max_memory = "4.GB"
                max_time = "1.h"
            }
            process {
                """
                input[0] = Channel.of("${outputDir}/antismash_db")
                """
            }
        }

        then {
            assert process.success
            assert process.out.databases.size() == 1
            assert process.out.databases[0].toString().contains("antismash_db")
            assert process.out.marker.size() == 1
        }
    }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/andreassag/clystere/main/assets/schema_input.json",
  "title": "clystere input samplesheet schema",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["sample", "genome"],
    "properties": {
      "sample": {
        "type": "string",
        "pattern": "^\\S+$",
        "meta": ["id"]
      },
      "genome": {
        "type": "string",
        "format": "file-path",
        "pattern": "^\\S+\\.(gbk|gb|gbff|gbf|fa|fna|fasta|gbk\\.gz|gb\\.gz|gbff\\.gz|gbf\\.gz|fa\\.gz|fna\\.gz|fasta\\.gz)$"
      },
      "annotation": {
        "type": "string",
        "format": "file-path",
        "pattern": "^\\S+\\.(gff|gff3|gff\\.gz|gff3\\.gz)$"
      },
      "fastq_1": {
        "type": "string",
        "format": "file-path",
        "pattern": "^\\S+\\.(fq|fastq)(\\.gz)?$"
      },
      "fastq_2": {
        "type": "string",
        "format": "file-path",
        "pattern": "^\\S+\\.(fq|fastq)(\\.gz)?$"
      },
      "assay_type": {
        "type": "string",
        "enum": ["metagenome", "metatranscriptome"]
      }
    }
  }
}

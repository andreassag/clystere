/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines compact BGC-bearing slices for fast, real end-to-end pipeline testing.

    Use as follows:
        nextflow run andreassag/clystere -profile test,<docker/apptainer/singularity>
----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal compact BGC test dataset to check pipeline function'
    // Input data
    input                      = "${projectDir}/tests/data/samplesheet_test.csv"
    outdir                     = 'results_test'
    // Pipeline options
    antismash_cb_knownclusters = true
    gecco_run                  = true
    deepbgc_run                = true
    bigscape_run               = false
    bigslice_run               = false
    run_tabulation             = true
}

process {
    resourceLimits = [
        cpus: 4,
        memory: 8.GB,
        time: 6.h
    ]
}

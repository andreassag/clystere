/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running full-size tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a full-size pipeline test.

    Use as follows:
        nextflow run exterex/clystere -profile test_full,<docker/singularity>
----------------------------------------------------------------------------------------
*/

params {
  config_profile_name = 'Full test profile'
  config_profile_description = 'Full-size test dataset to benchmark pipeline function'
  // Input data
  input = "${projectDir}/assets/samplesheet.csv"
  outdir = 'results'
  // Pipeline options
  antismash_cb_knownclusters = true
  run_bigscape = false
  run_tabulation = true
}

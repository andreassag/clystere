/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running full-size tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines full-genome input files to benchmark complete pipeline + BiG-SCAPE clustering.

    Use as follows:
        nextflow run andreassag/clystere -profile test_full,<docker/apptainer/singularity>
----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Full test profile'
    config_profile_description = 'Full-size test dataset to benchmark pipeline and BiG-SCAPE clustering'
    // Input data
    input                      = "${projectDir}/assets/samplesheet.csv"
    outdir                     = 'results_test_full'
    // Pipeline options
    antismash_cb_knownclusters = true
    gecco_run                  = true
    deepbgc_run                = true
    bigscape_run               = true
    bigslice_run               = false
    run_tabulation             = true
}

process {
    resourceLimits = [
        cpus: 4,
        memory: 8.GB,
        time: 6.h
    ]
}

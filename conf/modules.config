/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Module-specific configuration: ext.args, publishDir, containerOptions
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
  withName: 'ANTISMASH' {
    containerOptions = {
      workflow.containerEngine == 'docker' ? '--user root': ''
    }
    ext.args = {
      [
        // ── minimal mode & per-module enable flags ──
        params.antismash_minimal ? '--minimal': '',
        params.antismash_enable_genefunctions ? '--enable-genefunctions': '',
        params.antismash_enable_lanthipeptides ? '--enable-lanthipeptides': '',
        params.antismash_enable_lassopeptides ? '--enable-lassopeptides': '',
        params.antismash_enable_nrps_pks ? '--enable-nrps-pks': '',
        params.antismash_enable_sactipeptides ? '--enable-sactipeptides': '',
        params.antismash_enable_t2pks ? '--enable-t2pks': '',
        params.antismash_enable_terpene ? '--enable-terpene': '',
        params.antismash_enable_thiopeptides ? '--enable-thiopeptides': '',
        params.antismash_enable_tta ? '--enable-tta': '',
        params.antismash_enable_html ? '--enable-html': '',
        // ── additional analysis modules ──
        params.antismash_fullhmmer ? '--fullhmmer': '',
        params.antismash_cassis ? '--cassis': '',
        params.antismash_clusterhmmer ? '--clusterhmmer': '',
        params.antismash_tigrfam ? '--tigrfam': '',
        params.antismash_asf ? '--asf': '',
        params.antismash_pfam2go ? '--pfam2go': '',
        params.antismash_rre ? '--rre': '',
        params.antismash_smcog_trees ? '--smcog-trees': '',
        params.antismash_tfbs ? '--tfbs': '',
        // ── cluster comparison / annotation ──
        params.antismash_cc_mibig ? '--cc-mibig': '',
        params.antismash_cc_custom_dbs ? "--cc-custom-dbs ${params.antismash_cc_custom_dbs}": '',
        params.antismash_cb_general ? '--cb-general': '',
        params.antismash_cb_knownclusters ? '--cb-knownclusters': '',
        params.antismash_cb_subclusters ? '--cb-subclusters': '',
        params.antismash_cb_nclusters != null ? "--cb-nclusters ${params.antismash_cb_nclusters}": '',
        params.antismash_cb_min_homology_scale != null ? "--cb-min-homology-scale ${params.antismash_cb_min_homology_scale}": '',
        // ── hmm detection ──
        "--taxon ${params.antismash_taxon}",
        "--hmmdetection-strictness ${params.antismash_hmmdetection_strictness}",
        params.antismash_hmmdetection_fungal_cutoff_multiplier != null ? "--hmmdetection-fungal-cutoff-multiplier ${params.antismash_hmmdetection_fungal_cutoff_multiplier}": '',
        params.antismash_hmmdetection_fungal_neighbourhood_multiplier != null ? "--hmmdetection-fungal-neighbourhood-multiplier ${params.antismash_hmmdetection_fungal_neighbourhood_multiplier}": '',
        params.antismash_hmmdetection_limit_to_rule_names != null ? "--hmmdetection-limit-to-rule-names ${params.antismash_hmmdetection_limit_to_rule_names}": '',
        params.antismash_hmmdetection_limit_to_rule_categories != null ? "--hmmdetection-limit-to-rule-categories ${params.antismash_hmmdetection_limit_to_rule_categories}": '',
        // ── module parameter overrides ──
        "--minlength ${params.antismash_minlength}",
        params.antismash_limit != -1 && params.antismash_limit != null ? "--limit ${params.antismash_limit}": '',
        params.antismash_fullhmmer_pfamdb_version != null ? "--fullhmmer-pfamdb-version ${params.antismash_fullhmmer_pfamdb_version}": '',
        params.antismash_clusterhmmer_pfamdb_version != null ? "--clusterhmmer-pfamdb-version ${params.antismash_clusterhmmer_pfamdb_version}": '',
        params.antismash_rre_cutoff != null ? "--rre-cutoff ${params.antismash_rre_cutoff}": '',
        params.antismash_rre_minlength != null ? "--rre-minlength ${params.antismash_rre_minlength}": '',
        params.antismash_tfbs_pvalue != null ? "--tfbs-pvalue ${params.antismash_tfbs_pvalue}": '',
        params.antismash_tfbs_range != null ? "--tfbs-range ${params.antismash_tfbs_range}": '',
        params.antismash_tta_threshold != null ? "--tta-threshold ${params.antismash_tta_threshold}": '',
        // ── sideload ──
        params.antismash_sideload != null ? "--sideload ${params.antismash_sideload}": '',
        params.antismash_sideload_simple != null ? "--sideload-simple ${params.antismash_sideload_simple}": '',
        params.antismash_sideload_by_cds != null ? "--sideload-by-cds ${params.antismash_sideload_by_cds}": '',
        // ── output flags ──
        params.antismash_allow_long_headers ? '--allow-long-headers': '',
        params.antismash_zip_output == true ? '--zip-output': (params.antismash_zip_output == false ? '--no-zip-output': ''),
        params.antismash_summary_gbk == true ? '--summary-gbk': (params.antismash_summary_gbk == false ? '--no-summary-gbk': ''),
        params.antismash_region_gbks == true ? '--region-gbks': (params.antismash_region_gbks == false ? '--no-region-gbks': ''),
        // ── extra passthrough ──
        params.antismash_extra_args ?: '',
      ].join(' ').trim()
    }
    publishDir = [
      path: {
        "${params.outdir}/antismash"
      },
      mode: params.publish_dir_mode,
      saveAs: {
        filename -> filename == 'versions.yml' ? null: filename
      }
    ]
  }
  withName: 'ANTISMASH_DOWNLOAD_DATABASES' {
    ext.args = ''
    containerOptions = {
      workflow.containerEngine == 'docker' ? '--user root': ''
    }
  }
  withName: 'BIGSCAPE' {
    ext.args = {
      [
        params.bigscape_mix ? '--mix': '',
        "--classify ${params.bigscape_classify}",
        params.bigscape_include_singletons ? '--include-singletons': '',
        params.bigscape_gcf_cutoffs.tokenize(' ').collect {
          "--gcf-cutoffs ${it}"
        }.join(' '),
        params.bigscape_extra_args ?: '',
      ].join(' ').trim()
    }
    publishDir = [
      path: {
        "${params.outdir}"
      },
      mode: params.publish_dir_mode,
      saveAs: {
        filename -> filename == 'versions.yml' ? null: filename
      }
    ]
  }
  withName: 'BIGSLICE' {
    ext.args = {
      [
        params.bigslice_extra_args ?: '',
      ].join(' ').trim()
    }
    publishDir = [
      path: {
        "${params.outdir}"
      },
      mode: params.publish_dir_mode,
      saveAs: {
        filename -> filename == 'versions.yml' ? null: filename
      }
    ]
  }
  withName: 'TABULATE_REGIONS' {
    publishDir = [
      path: {
        "${params.outdir}/summary"
      },
      mode: params.publish_dir_mode,
      saveAs: {
        filename -> filename == 'versions.yml' ? null: filename
      }
    ]
  }
  withName: 'COUNT_REGIONS' {
    publishDir = [
      path: {
        "${params.outdir}/summary"
      },
      mode: params.publish_dir_mode,
      saveAs: {
        filename -> filename == 'versions.yml' ? null: filename
      }
    ]
  }
}

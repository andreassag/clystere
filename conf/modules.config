/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Module-specific configuration: ext.args, publishDir
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    // ──────────────────────────────────────────────
    // Phase 0: Guard database cache publishDir against -stub-run pollution
    // ──────────────────────────────────────────────
    withName: 'ANTISMASH_ANTISMASHDOWNLOADDATABASES|DEEPBGC_DOWNLOAD|BIGSLICE_DOWNLOADDB' {
        ext.args = ''
        publishDir = [
            path: { "${params.clystere_db_dir}" },
            mode: 'copy',
            enabled: { !workflow.stubRun },
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }

    withName: 'BAKTA_BAKTADBDOWNLOAD' {
        ext.args = { "--type ${params.bakta_db_type}" }
        publishDir = [
            path: { "${params.clystere_db_dir}/bakta_db" },
            mode: 'copy',
            enabled: { !workflow.stubRun },
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }

    withName: 'CHECKM2_DATABASEDOWNLOAD' {
        ext.args = ''
        publishDir = [
            path: { "${params.clystere_db_dir}/checkm2_db" },
            mode: 'copy',
            enabled: { !workflow.stubRun },
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }

    withName: 'GTDBTK_DOWNLOADDB' {
        ext.args = ''
        publishDir = [
            path: { "${params.clystere_db_dir}" },
            mode: 'copy',
            enabled: { !workflow.stubRun },
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }

    withName: 'PREPARE_AMP_DB' {
        ext.args = ''
        publishDir = [
            path: { "${params.clystere_db_dir}" },
            mode: 'copy',
            enabled: { !workflow.stubRun && !params.amp_database_dir },
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }

    // ──────────────────────────────────────────────
    // Tier 1 & Tier 4: Preprocessing, dereplication, QC & taxonomy
    // ──────────────────────────────────────────────
    withName: 'PYRODIGAL' {
        ext.args = { "-p ${params.pyrodigal_mode}" }
        publishDir = [
            path: { "${params.outdir}/preprocessing/pyrodigal" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }

    withName: 'BAKTA_BAKTA' {
        ext.args = ''
        publishDir = [
            path: { "${params.outdir}/preprocessing/bakta/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }

    withName: 'SKANI_TRIANGLE|DEREP_SELECT|DREP_DEREPLICATE' {
        publishDir = [
            path: { "${params.outdir}/dereplication" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }

    withName: 'DREP_DEREPLICATE' {
        ext.args = { "-sa ${params.dereplicate_ani / 100.0}" }
    }

    withName: 'QUAST' {
        ext.args = ''
        publishDir = [
            path: { "${params.outdir}/qc/quast" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }

    withName: 'CHECKM2_PREDICT' {
        ext.args = ''
        publishDir = [
            path: { "${params.outdir}/qc/checkm2" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }

    withName: 'GTDBTK_CLASSIFYWF' {
        ext.args = { "--extension fna ${params.gtdbtk_extra_args ?: ''}".trim() }
        publishDir = [
            path: { "${params.outdir}/taxonomy/gtdbtk" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }

    // ──────────────────────────────────────────────
    // Core + Tier 2: BGC & AMP discovery
    // ──────────────────────────────────────────────
    withName: 'ANTISMASH_ANTISMASH' {
        ext.args = {
            [
                // ── minimal mode & per-module enable flags ──
                params.antismash_minimal ? '--minimal' : '',
                params.antismash_enable_genefunctions ? '--enable-genefunctions' : '',
                (params.antismash_enable_lanthipeptides || params.ripp_preset) ? '--enable-lanthipeptides' : '',
                (params.antismash_enable_lassopeptides || params.ripp_preset) ? '--enable-lassopeptides' : '',
                params.antismash_enable_nrps_pks ? '--enable-nrps-pks' : '',
                (params.antismash_enable_sactipeptides || params.ripp_preset) ? '--enable-sactipeptides' : '',
                params.antismash_enable_t2pks ? '--enable-t2pks' : '',
                params.antismash_enable_terpene ? '--enable-terpene' : '',
                (params.antismash_enable_thiopeptides || params.ripp_preset) ? '--enable-thiopeptides' : '',
                params.antismash_enable_tta ? '--enable-tta' : '',
                params.antismash_enable_html ? '--enable-html' : '',
                // ── additional analysis modules ──
                params.antismash_fullhmmer ? '--fullhmmer' : '',
                params.antismash_cassis ? '--cassis' : '',
                (params.antismash_clusterhmmer || params.ripp_preset) ? '--clusterhmmer' : '',
                params.antismash_tigrfam ? '--tigrfam' : '',
                (params.antismash_asf || params.ripp_preset) ? '--asf' : '',
                params.antismash_pfam2go ? '--pfam2go' : '',
                (params.antismash_rre || params.ripp_preset) ? '--rre' : '',
                params.antismash_smcog_trees ? '--smcog-trees' : '',
                params.antismash_tfbs ? '--tfbs' : '',
                // ── cluster comparison / annotation ──
                params.antismash_cc_mibig ? '--cc-mibig' : '',
                params.antismash_cc_custom_dbs ? "--cc-custom-dbs ${params.antismash_cc_custom_dbs}" : '',
                params.antismash_cb_general ? '--cb-general' : '',
                params.antismash_cb_knownclusters ? '--cb-knownclusters' : '',
                params.antismash_cb_subclusters ? '--cb-subclusters' : '',
                params.antismash_cb_nclusters != null ? "--cb-nclusters ${params.antismash_cb_nclusters}" : '',
                params.antismash_cb_min_homology_scale != null ? "--cb-min-homology-scale ${params.antismash_cb_min_homology_scale}" : '',
                // ── hmm detection ──
                "--taxon ${params.antismash_taxon}",
                "--hmmdetection-strictness ${params.antismash_hmmdetection_strictness}",
                params.antismash_hmmdetection_fungal_cutoff_multiplier != null ? "--hmmdetection-fungal-cutoff-multiplier ${params.antismash_hmmdetection_fungal_cutoff_multiplier}" : '',
                params.antismash_hmmdetection_fungal_neighbourhood_multiplier != null ? "--hmmdetection-fungal-neighbourhood-multiplier ${params.antismash_hmmdetection_fungal_neighbourhood_multiplier}" : '',
                params.antismash_hmmdetection_limit_to_rule_names != null ? "--hmmdetection-limit-to-rule-names ${params.antismash_hmmdetection_limit_to_rule_names}" : '',
                params.antismash_hmmdetection_limit_to_rule_categories != null ? "--hmmdetection-limit-to-rule-categories ${params.antismash_hmmdetection_limit_to_rule_categories}" : '',
                // ── module parameter overrides ──
                "--minlength ${params.antismash_minlength}",
                params.antismash_limit != -1 && params.antismash_limit != null ? "--limit ${params.antismash_limit}" : '',
                params.antismash_fullhmmer_pfamdb_version != null ? "--fullhmmer-pfamdb-version ${params.antismash_fullhmmer_pfamdb_version}" : '',
                params.antismash_clusterhmmer_pfamdb_version != null ? "--clusterhmmer-pfamdb-version ${params.antismash_clusterhmmer_pfamdb_version}" : '',
                params.antismash_rre_cutoff != null ? "--rre-cutoff ${params.antismash_rre_cutoff}" : '',
                params.antismash_rre_minlength != null ? "--rre-minlength ${params.antismash_rre_minlength}" : '',
                params.antismash_tfbs_pvalue != null ? "--tfbs-pvalue ${params.antismash_tfbs_pvalue}" : '',
                params.antismash_tfbs_range != null ? "--tfbs-range ${params.antismash_tfbs_range}" : '',
                params.antismash_tta_threshold != null ? "--tta-threshold ${params.antismash_tta_threshold}" : '',
                // ── sideload ──
                params.antismash_sideload != null ? "--sideload ${params.antismash_sideload}" : '',
                params.antismash_sideload_simple != null ? "--sideload-simple ${params.antismash_sideload_simple}" : '',
                params.antismash_sideload_by_cds != null ? "--sideload-by-cds ${params.antismash_sideload_by_cds}" : '',
                // ── output flags ──
                params.antismash_allow_long_headers ? '--allow-long-headers' : '',
                params.antismash_zip_output == true ? '--zip-output' : (params.antismash_zip_output == false ? '--no-zip-output' : ''),
                params.antismash_summary_gbk == true ? '--summary-gbk' : (params.antismash_summary_gbk == false ? '--no-summary-gbk' : ''),
                params.antismash_region_gbks == true ? '--region-gbks' : (params.antismash_region_gbks == false ? '--no-region-gbks' : ''),
                // ── extra passthrough ──
                params.antismash_extra_args ?: '',
            ].findAll { arg -> arg }.unique().join(' ').trim()
        }
        publishDir = [
            path: { "${params.outdir}/antismash" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }

    withName: 'GECCO_RUN' {
        ext.args = { params.gecco_extra_args ?: '' }
        publishDir = [
            path: { "${params.outdir}/gecco/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }

    withName: 'GECCO_CONVERT' {
        ext.args = ''
        publishDir = [
            path: { "${params.outdir}/gecco" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }

    withName: 'DEEPBGC_PIPELINE' {
        ext.args = { params.deepbgc_extra_args ?: '' }
        publishDir = [
            path: { "${params.outdir}/deepbgc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }

    withName: 'SANNTIS' {
        ext.args = { params.sanntis_extra_args ?: '' }
        publishDir = [
            path: { "${params.outdir}/sanntis" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }

    withName: 'MACREL_CONTIGS' {
        ext.args = ''
        publishDir = [
            path: { "${params.outdir}/amp/macrel" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }

    withName: 'AMPCOMBI2_PARSETABLES' {
        ext.args = '--macrel_file .macrel.prediction'
        publishDir = [
            path: { "${params.outdir}/amp/ampcombi" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }

    withName: 'AMPCOMBI2_COMPLETE' {
        ext.args = ''
        publishDir = [
            path: { "${params.outdir}/amp/ampcombi" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }

    withName: 'AMPCOMBI2_CLUSTER' {
        ext.args = '--cluster_keep_singletons --cluster_min_member 1'
        publishDir = [
            path: { "${params.outdir}/amp/ampcombi" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }

    // ──────────────────────────────────────────────
    // Clustering & Tier 3 Comparative Genomics
    // ──────────────────────────────────────────────
    withName: 'COMBGC_FILTER' {
        ext.args = ''
        publishDir = [
            path: { "${params.outdir}/combgc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }

    withName: 'BIGSCAPE' {
        ext.args = {
            [
                params.bigscape_mix ? '--mix' : '',
                "--classify ${params.bigscape_classify}",
                params.bigscape_include_singletons ? '--include-singletons' : '',
                params.bigscape_gcf_cutoffs.tokenize(' ').collect { cutoff ->
                    "--gcf-cutoffs ${cutoff}"
                }.join(' '),
                params.bigscape_extra_args ?: '',
            ].findAll { arg -> arg }.join(' ').trim()
        }
        ext.args2 = { "--cutoff ${params.bigscape_dereplicate_cutoff}" }
        publishDir = [
            path: { "${params.outdir}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }

    withName: 'BIGSLICE_BIGSLICE' {
        ext.args = { params.bigslice_extra_args ?: '' }
        publishDir = [
            path: { "${params.outdir}/bigslice" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }

    withName: 'BIGSLICE_QUERY' {
        ext.args = {
            [
                params.bigfam_no_normalize ? '--no_normalize_feature' : '',
                params.bigslice_extra_args ?: '',
            ].findAll { arg -> arg }.join(' ').trim()
        }
        publishDir = [
            path: { "${params.outdir}/bigfam_query" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }

    withName: 'GROUP_GCF_GBKS' {
        publishDir = [
            path: { "${params.outdir}/comparative" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'gcf_membership_summary.tsv' ? filename : null }
        ]
    }

    withName: 'CLINKER' {
        ext.args = { params.clinker_extra_args ?: '' }
        publishDir = [
            path: { "${params.outdir}/clinker" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }

    withName: 'CBLASTER_MAKEDB|CBLASTER_SEARCH' {
        ext.args = { params.cblaster_extra_args ?: '' }
        publishDir = [
            path: { "${params.outdir}/cblaster" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }

    // ──────────────────────────────────────────────
    // Tier 4: Metagenomic & Metatranscriptomic Abundance
    // ──────────────────────────────────────────────
    withName: 'PREPARE_BGC_REFERENCE|AGGREGATE_BGC_ABUNDANCE' {
        publishDir = [
            path: { "${params.outdir}/abundance" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }

    withName: 'SAMTOOLS_SORT' {
        ext.prefix = { "${meta.id}.sorted" }
    }

    withName: 'MINIMAP2_INDEX' {
        ext.args = {
            def raw = params.minimap2_extra_args ?: '-ax sr'
            def m = (raw =~ /-a?x\s+(\S+)/)
            m.find() ? "-x ${m.group(1)}" : ''
        }
    }

    withName: 'MINIMAP2_ALIGN' {
        ext.args = { params.minimap2_extra_args ?: '-ax sr' }
    }

    withName: 'COVERM_CONTIG' {
        ext.args = { "--methods tpm rpkm mean covered_fraction count --min-read-percent-identity ${params.abundance_min_identity}" }
        publishDir = [
            path: { "${params.outdir}/abundance/coverm" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }

    // ──────────────────────────────────────────────
    // Summary, Consensus & MultiQC
    // ──────────────────────────────────────────────
    withName: 'SUMMARY' {
        ext.args = { params.antismash_cb_knownclusters ? '--knownclusters' : '' }
        ext.args2 = {
            [
                params.count_per_contig ? '--by_contig' : '',
                params.split_hybrids ? '--split_hybrids' : '',
            ].findAll { arg -> arg }.join(' ').trim()
        }
        ext.args3 = {
            (
                params.ripp_preset ||
                params.antismash_rre ||
                params.antismash_enable_lanthipeptides ||
                params.antismash_enable_lassopeptides ||
                params.antismash_enable_sactipeptides ||
                params.antismash_enable_thiopeptides
            ) ? '--extract-ripps' : ''
        }
        publishDir = [
            path: { "${params.outdir}/summary" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }

    withName: 'CONSENSUS_SUMMARY' {
        publishDir = [
            path: { "${params.outdir}/summary" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }

    withName: 'MULTIQC' {
        ext.args = { params.multiqc_title ? "--title \"${params.multiqc_title}\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }
}

/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    clystere Nextflow config
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
  // ──────────────────────────────────────────────
  // Input / output
  // ──────────────────────────────────────────────
  input = null
  outdir = 'results'
  // ──────────────────────────────────────────────
  // antiSMASH
  // ──────────────────────────────────────────────
  antismash_db = null
  // ── Basic analysis ─────────────────────────────
  antismash_taxon = 'bacteria'  // bacteria | fungi
  antismash_genefinding_tool = 'prodigal'  // prodigal | prodigal-m | none | error
  antismash_minlength = 1000
  antismash_limit = -1          // -1 to disable
  // ── Minimal mode ───────────────────────────────
  antismash_minimal = true
  antismash_enable_genefunctions = false  // --enable-genefunctions
  antismash_enable_lanthipeptides = false  // --enable-lanthipeptides
  antismash_enable_lassopeptides = false  // --enable-lassopeptides
  antismash_enable_nrps_pks = false  // --enable-nrps-pks
  antismash_enable_sactipeptides = false  // --enable-sactipeptides
  antismash_enable_t2pks = false  // --enable-t2pks
  antismash_enable_terpene = false  // --enable-terpene
  antismash_enable_thiopeptides = false  // --enable-thiopeptides
  antismash_enable_tta = false  // --enable-tta
  antismash_enable_html = false  // --enable-html
  // ── Additional analysis modules ────────────────
  antismash_fullhmmer = false  // --fullhmmer
  antismash_cassis = false  // --cassis
  antismash_clusterhmmer = false  // --clusterhmmer
  antismash_tigrfam = false  // --tigrfam
  antismash_asf = false  // --asf
  antismash_pfam2go = false  // --pfam2go
  antismash_rre = false  // --rre
  antismash_smcog_trees = false  // --smcog-trees
  antismash_tfbs = false  // --tfbs
  // ── Cluster comparison / annotation ───────────
  antismash_cc_mibig = false  // --cc-mibig
  antismash_cc_custom_dbs = null   // --cc-custom-dbs  comma-separated db config files
  antismash_cb_general = false  // --cb-general
  antismash_cb_knownclusters = false  // --cb-knownclusters
  antismash_cb_subclusters = false  // --cb-subclusters
  antismash_cb_nclusters = null   // --cb-nclusters  default: 10
  antismash_cb_min_homology_scale = null   // --cb-min-homology-scale  0.0–1.0
  // ── HMM detection ─────────────────────────────
  antismash_hmmdetection_strictness = 'relaxed'  // strict | relaxed | loose
  antismash_hmmdetection_fungal_cutoff_multiplier = null
  antismash_hmmdetection_fungal_neighbourhood_multiplier = null
  antismash_hmmdetection_limit_to_rule_names = null
  antismash_hmmdetection_limit_to_rule_categories = null
  // ── Module parameters ─────────────────────────
  antismash_fullhmmer_pfamdb_version = null
  antismash_clusterhmmer_pfamdb_version = null
  antismash_rre_cutoff = null
  antismash_rre_minlength = null
  antismash_tfbs_pvalue = null
  antismash_tfbs_range = null
  antismash_tta_threshold = null
  // ── Sideload ──────────────────────────────────
  antismash_sideload = null   // --sideload  comma-separated JSON paths
  antismash_sideload_simple = null   // --sideload-simple  ACCESSION:START-END
  antismash_sideload_by_cds = null   // --sideload-by-cds  locus1,locus2,...
  // ── Output ────────────────────────────────────
  antismash_zip_output = false  // null | true | false
  antismash_summary_gbk = null   // null | true | false
  antismash_region_gbks = null   // null | true | false
  antismash_allow_long_headers = true
  antismash_extra_args = ""
  antismash_accept_failure = false
  antismash_reuse_results = false
  // ──────────────────────────────────────────────
  // BiG-SCAPE
  // ──────────────────────────────────────────────
  run_bigscape = false
  bigscape_pfam_path = null
  bigscape_gcf_cutoffs = '0.3 0.5 0.7'  // space-separated list
  bigscape_mix = true
  bigscape_classify = 'none'         // none | classify
  bigscape_include_singletons = true
  bigscape_extra_args = ""
  bigscape_zip_output = false
  // ──────────────────────────────────────────────
  // Tabulation / summary
  // ──────────────────────────────────────────────
  run_tabulation = true
  count_per_contig = false
  split_hybrids = false
  // ──────────────────────────────────────────────
  // Nextflow internals
  // ──────────────────────────────────────────────
  publish_dir_mode = 'copy'  // copy | symlink | move | rellink | link
  monochrome_logs = false
  help = false
  version = false
  // ──────────────────────────────────────────────
  // nf-core / institutional config
  // ──────────────────────────────────────────────
  custom_config_version = 'master'
  custom_config_base = "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}"
  config_profile_contact = null
  config_profile_url = null
  config_profile_name = null
  config_profile_description = null
}

// Load base resource config
includeConfig 'conf/base.config'

// Load module-level ext.args
includeConfig 'conf/modules.config'

// Load nf-core custom profiles from different institutions
includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http'))
 ? "${params.custom_config_base}/nfcore_custom.config": "/dev/null"

// Execution profiles
profiles {
  debug {
    process.beforeScript = 'echo $HOSTNAME'
  }
  // ── Container engines ──────────────────────────
  docker {
    docker.enabled = true
    docker.runOptions = '-u $(id -u):$(id -g)'
    singularity.enabled = false
    conda.enabled = false
  }
  singularity {
    singularity.enabled = true
    singularity.autoMounts = true
    docker.enabled = false
    conda.enabled = false
  }
  apptainer {
    apptainer.enabled = true
    apptainer.autoMounts = true
    docker.enabled = false
    singularity.enabled = false
    conda.enabled = false
  }
  podman {
    podman.enabled = true
    docker.enabled = false
    singularity.enabled = false
    conda.enabled = false
  }
  // ── Software environments ──────────────────────
  conda {
    conda.enabled = true
    docker.enabled = false
    singularity.enabled = false
  }
  // ── Test profiles ─────────────────────────────
  test {
    includeConfig 'conf/test.config'
  }
  test_full {
    includeConfig 'conf/test_full.config'
  }
  // ── HPC / cluster ─────────────────────────────
  // Raise resource ceilings without binding to a specific scheduler.
  hpc {
    process {
      resourceLimits = [cpus: 64, memory: 256.GB, time: 720.h]
    }
  }
  // SLURM executor + elevated resource ceilings.
  slurm {
    process {
      executor = 'slurm'
      resourceLimits = [cpus: 64, memory: 256.GB, time: 720.h]
    }
  }
}

process.shell = ['/bin/bash', '-euo', 'pipefail']

// Capture pipeline execution metadata
def trace_timestamp = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
timeline {
  enabled = true
  file = "${params.outdir}/pipeline_info/execution_timeline_${trace_timestamp}.html"
}
report {
  enabled = true
  file = "${params.outdir}/pipeline_info/execution_report_${trace_timestamp}.html"
}
trace {
  enabled = true
  file = "${params.outdir}/pipeline_info/execution_trace_${trace_timestamp}.txt"
}
dag {
  enabled = true
  file = "${params.outdir}/pipeline_info/pipeline_dag_${trace_timestamp}.html"
}

manifest {
  name = 'exterex/clystere'
  author = 'Andreas Sagen'
  homePage = 'https://github.com/exterex/clystere'
  description = 'Nextflow pipeline for antiSMASH + BiG-SCAPE BGC analysis'
  mainScript = 'main.nf'
  nextflowVersion = '!>=23.04.0'
  version = '1.0.0-dev'
}

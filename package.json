{
  "name": "clystere",
  "version": "1.1.0",
  "scripts": {
    "lint:ruff": "ruff check .",
    "lint:editorconfig": "editorconfig-checker",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "check:all": "ruff check . && ruff format --check . && npx -y editorconfig-checker && npx -y prettier --check ."
  },
  "devDependencies": {
    "editorconfig-checker": "^6.0.0",
    "prettier": "3.9.6"
  }
}
